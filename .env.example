# Public marketing site (all optional; unset values hide the matching links)
NEXT_PUBLIC_SITE_URL=https://vano.app
# Vano's WhatsApp number, international format (+254…): footer, Help, "Talk to us"
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Support email shown on the Help page
NEXT_PUBLIC_CONTACT_EMAIL=

# Emails are configured on the Convex deployment, not here:
#   npx convex env set RESEND_API_KEY re_...          (unset = log mode: emails go to the Convex logs)
#   npx convex env set EMAIL_FROM "Vano <hello@your-domain>"   (domain verified in Resend)
#   npx convex env set EMAIL_REPLY_TO support@your-domain      (optional)

# Security headers (src/lib/security-headers.ts). The CSP allows the Convex
# origin from NEXT_PUBLIC_CONVEX_URL (set by `npx convex dev`). Only set this
# if storage files are served from another origin (e.g. a custom domain):
# CONVEX_STORAGE_ORIGIN=https://files.your-domain
